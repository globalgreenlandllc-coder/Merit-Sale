# ---- Database. A file: URL selects the SQLite schema (local); any other URL selects PostgreSQL.
# Production: a Postgres URL from Neon / Vercel Postgres / Supabase, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="file:./dev.db"
# Direct (unpooled) Postgres URL for db push and migrations. Neon/Vercel provide DATABASE_URL_UNPOOLED; otherwise set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ---- Sessions and sign-in
SESSION_SECRET="dev-only-change-me-before-any-deploy"
# AUTH_MODE: email (one-time codes; production default) or demo (development default).
AUTH_MODE=
# Staff roles are granted from these comma-separated lists at sign-in; nobody becomes staff by signing up.
PLATFORM_ADMIN_EMAILS=
ADMINISTRATOR_EMAILS=
AUDITOR_EMAILS=
ITEM_AUTHOR_EMAILS=
# Demo personas (all roles, no verification) — insecure; only for a demo deployment.
AUTH_DEMO_PERSONAS=false
# Email delivery for sign-in codes and notices (Resend). Without a key, codes go to the server log.
RESEND_API_KEY=
EMAIL_FROM="Earn the Keys <onboarding@resend.dev>"

# ---- Independent Administrator seal key (32-byte hex). In production this lives in a KMS
# principal the platform cannot read; the platform receives unsealed material only per round.
# Generate with: npm run keys:generate
ADMINISTRATOR_SEAL_KEY=

# ---- Payments: mock (practice / local) or stripe
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTODIAN_ACCOUNT_ID=

# ---- Identity verification / sanctions / proctoring adapters (mock until vendor keys exist)
IDV_PROVIDER=mock
SANCTIONS_PROVIDER=mock
PROCTORING_PROVIDER=mock

# ---- Geolocation. In production the edge/CDN sets region headers; locally we pin a state.
GEO_DEV_STATE=WA

# ---- Property photography storage. Local: UPLOADS_DIR (outside public/, served by /api/uploads).
# Vercel: create a Blob store; BLOB_READ_WRITE_TOKEN switches storage to object storage automatically.
UPLOADS_DIR=./uploads
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
