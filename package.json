{
  "name": "earn-the-keys",
  "private": true,
  "description": "Earn the Keys \u2014 the Merit Sale platform. Homes sold through paid-registration, objectively scored reasoning competitions.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @etk/web",
    "build": "npm run build -w @etk/web",
    "start": "npm run start -w @etk/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push -w @etk/web",
    "db:seed": "npm run db:seed -w @etk/web",
    "db:reset": "npm run db:reset -w @etk/web",
    "keys:generate": "node -e \"console.log('ADMINISTRATOR_SEAL_KEY=' + require('crypto').randomBytes(32).toString('hex'))\"",
    "setup": "npm install && npm run db:push && npm run db:seed"
  },
  "engines": {
    "node": "22.x"
  }
}
