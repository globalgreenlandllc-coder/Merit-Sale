{
  "name": "@etk/web",
  "version": "0.1.0",
  "private": true,
  "description": "Earn the Keys \u2014 public site, registrant test client, platform admin, and independent administrator console.",
  "scripts": {
    "dev": "next dev",
    "build": "node prisma/select.mjs && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:select": "node prisma/select.mjs",
    "db:push": "node prisma/select.mjs && prisma db push",
    "db:seed": "node prisma/select.mjs && tsx prisma/seed.ts",
    "db:reset": "node prisma/select.mjs && prisma db push && tsx prisma/seed.ts",
    "postinstall": "node prisma/select.mjs && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@etk/items": "*",
    "@etk/rules-config": "*",
    "@etk/scoring": "*",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.8.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^22.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
